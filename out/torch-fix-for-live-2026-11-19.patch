+	#    otherwise there is no dynamic torch light to render at all.
+	var chunk: Vector2i = far_torch["chunk"]
+	var material: ShaderMaterial = _chunk_material(chunk)
+	check(material != null, "far torch chunk %s has a terrain material" % str(chunk))
+	if material != null:
+		check(material.shader != null and material.shader.resource_path == PIPELINE_SHADER,
+			"far torch chunk %s renders with %s" % [str(chunk), PIPELINE_SHADER])
+
+	# 3. Aim the camera at the real terrain vertex next to the far torch and
+	#    render with the torch pool active.
+	var torch_node: Node3D = subject.torch_nodes[torch_id] as Node3D
+	var lit_vertex: Dictionary = _nearest_terrain_vertex(torch_node.position)
+	check(lit_vertex.has("vertex"), "found a terrain vertex next to the far torch")
+	if lit_vertex.is_empty():
+		_finish()
+		return
+	var focus_world: Vector3 = subject.scene_root.to_global(lit_vertex["vertex"])
