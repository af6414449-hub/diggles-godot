+extends SceneTree
+## Render-visible regression test for automatic torch terrain lighting.
+##
+## torch_terrain_light_regression_self_test.gd proves the light magnitude that
+## reaches the terrain material. This test proves the light reaches the
+## rendered frame instead: it renders the same corridor twice and compares
+## pixels.
+##
+##   frame ON  : the automatic torch is in the runtime uniform pool
+##   frame OFF : the very same scene with the uniform pool emptied
+##
+## Only the dynamic torch light differs between the two frames, because the
+## baked vertex colours are never recomputed. If a torch exists but does not
+## light the terrain, both frames are identical and this test fails.
+##
+## Requires a real rendering context (not --headless):
+##   godot --path godot --rendering-driver opengl3 \
+##       --script res://tools/torch_render_visible_self_test.gd
+##
+## The two frames are written to
+##   ../docs/reverse-engineering/torch-render-visible/
+## so they can be inspected by eye.
+
+const PIPELINE_SHADER: String = "res://shaders/native_terrain_pipeline.gdshader"
+const ROI_FRACTION: float = 0.5
+const TOP_FRACTION: float = 0.10
+const MIN_LUMA_LIFT: float = 0.02
+
+var checks: int = 0
+var failures: int = 0
+var subject: Node3D = null
+var torches: Array[Dictionary] = []
+var output_dir: String = ""
+
+
+func _initialize() -> void:
+	call_deferred("_run")
+
+
+func check(condition: bool, message: String) -> void:
+	checks += 1
+	if not condition:
+		failures += 1
+		push_error("TORCH_RENDER_VISIBLE_FAILED " + message)
+
+
+func _run() -> void:
+	subject = load("res://scenes/multiplayer_test.tscn").instantiate() as Node3D
+	subject.extended_world = false # Keep the authored-template fixture.
+	root.add_child(subject)
+	subject.set_process(false)
+	await process_frame
+
+	var arguments: PackedStringArray = OS.get_cmdline_user_args()
+	if arguments.has("--capture-dir"):
+		var index: int = arguments.find("--capture-dir")
+		if index >= 0 and index + 1 < arguments.size():
+			output_dir = arguments[index + 1]
+	if output_dir.is_empty():
+		output_dir = ProjectSettings.globalize_path("res://").path_join("../docs/reverse-engineering/torch-render-visible")
+	DirAccess.make_dir_recursive_absolute(output_dir)
+
+	# 1. Spawn automatic torches in separated excavated corridors.
+	var anchors: Array[Vector2i] = [
+		Vector2i(1,15), Vector2i(1,3), Vector2i(1,7), Vector2i(1,11), Vector2i(1,19),
+		Vector2i(9,19), Vector2i(13,3), Vector2i(17,19), Vector2i(21,3), Vector2i(25,19),
+		Vector2i(29,3), Vector2i(33,19), Vector2i(37,3), Vector2i(37,7), Vector2i(37,11),
+		Vector2i(37,15), Vector2i(41,3), Vector2i(41,11), Vector2i(41,19), Vector2i(5,15)]
+	for anchor: Vector2i in anchors:
+		if torches.size() >= 9:
+			break
+		var block: Array[Vector2i] = [anchor, anchor + Vector2i.RIGHT,
+			anchor + Vector2i.DOWN, anchor + Vector2i.ONE]
+		var dug: int = 0
+		for point: Vector2i in block:
+			if subject.native_mark_corridor_cell(0, point) and subject.native_dig_apply_cell(0, point):
+				dug += 1
+		if dug < 3:
+			continue
+		var record: Dictionary = _spawn_torch_at(anchor)
+		if not record.is_empty():
+			torches.append(record)
+
+	check(torches.size() >= 3, "at least three automatic torches spawn in excavated corridors")
+	var far_torch: Dictionary = {}
+	for record: Dictionary in torches:
+		if far_torch.is_empty() or float(record["local"].x) > float(far_torch["local"].x):
+			far_torch = record
+	check(not far_torch.is_empty(), "a far automatic torch is available for the render check")
+	if torches.is_empty() or far_torch.is_empty():
+		_finish()
+		return
+
+	var torch_id: int = int(far_torch["id"])
+	print("TORCH_RENDER_VISIBLE target=%d local=%s chunk=%s" % [
+		torch_id, str(far_torch["local"]), str(far_torch["chunk"])])
+
