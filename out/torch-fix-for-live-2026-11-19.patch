+	subject.distance = 6.0
+	subject.pitch = 0.32
+	subject._update_camera()
+	await process_frame
+	await process_frame
+	await RenderingServer.frame_post_draw
+	var lit_image: Image = root.get_texture().get_image()
+	check(lit_image != null and not lit_image.is_empty(), "captured the frame with the torch pool active")
+	if lit_image == null or lit_image.is_empty():
+		_finish()
+		return
+	var lit_count: int = _uniform_count()
+
+	# 4. Render the identical scene with the dynamic torch pool emptied.
+	#    The baked vertex colours stay untouched, so this isolates the light.
+	subject.source_profile.set_dynamic_torch_lights([])
+	await process_frame
+	await process_frame
+	await RenderingServer.frame_post_draw
+	var dark_image: Image = root.get_texture().get_image()
+	check(dark_image != null and not dark_image.is_empty(), "captured the frame with the torch pool emptied")
+	if dark_image == null or dark_image.is_empty():
+		_finish()
+		return
+	var dark_count: int = _uniform_count()
+	check(lit_count >= 1 and dark_count == 0,
+		"the uniform pool really changed between the two frames (lit %d, dark %d)" % [lit_count, dark_count])
+
+	lit_image.save_png(output_dir.path_join("far_torch_lit.png"))
+	dark_image.save_png(output_dir.path_join("far_torch_dark.png"))
+
+	print("TORCH_RENDER_VISIBLE camera=%s focus=%s torch_world=%s vertex=%s" % [
+		str(subject.camera.global_position), str(subject.focus),
+		str(torch_node.global_position), str(lit_vertex["vertex"])])
+
+	var lit_value: float = _top_mean_luminance(lit_image)
+	var dark_value: float = _top_mean_luminance(dark_image)
+	var lift: float = lit_value - dark_value
+	print("TORCH_RENDER_VISIBLE lit_top=%.6f dark_top=%.6f lift=%.6f" % [
+		lit_value, dark_value, lift])
+	check(lift > MIN_LUMA_LIFT,
+		"the torch visibly lifts the rendered terrain: lift %.6f exceeds %.6f (lit %.6f, dark %.6f)" % [
+			lift, MIN_LUMA_LIFT, lit_value, dark_value])
+
+	_finish()
+
+
+## The dynamic torch count the real terrain material currently carries.
+func _uniform_count() -> int:
+	var material: ShaderMaterial = null
+	for key: String in subject.terrain_mesh_nodes.keys():
+		var node: MeshInstance3D = subject.terrain_mesh_nodes[key] as MeshInstance3D
+		if node.mesh.get_surface_count() > 0:
+			material = node.mesh.surface_get_material(0) as ShaderMaterial
+			break
+	if material == null:
+		return -1
+	return int(material.get_shader_parameter("dynamic_torch_count"))
+
+
+## Nearest terrain mesh vertex to a point given in scene-root space.
+func _nearest_terrain_vertex(point: Vector3) -> Dictionary:
+	var best: Dictionary = {}
+	var best_distance: float = INF
+	for key: String in subject.terrain_mesh_nodes.keys():
+		var node: MeshInstance3D = subject.terrain_mesh_nodes[key] as MeshInstance3D
+		var arrays: Array = node.mesh.surface_get_arrays(0)
+		var vertices: PackedVector3Array = arrays[Mesh.ARRAY_VERTEX]
+		for index: int in range(vertices.size()):
+			var vertex: Vector3 = vertices[index]
+			var distance: float = Vector2(vertex.x - point.x, vertex.y - point.y).length()
+			if distance < best_distance:
+				best_distance = distance
+				best = {"key": key, "index": index, "vertex": vertex, "distance": distance}
+	return best
+
+
+## Mean luminance of the brightest pixels inside the central region of the frame.
+## The lit corridor is a contiguous bright patch, so the top decile reacts to it
+## while the dark walls and background do not drown the signal.
+func _top_mean_luminance(image: Image) -> float:
+	var size: Vector2i = image.get_size()
+	var region: int = maxi(1, int(float(mini(size.x, size.y)) * ROI_FRACTION))
+	var origin: Vector2i = Vector2i((size.x - region) / 2, (size.y - region) / 2)
+	var luminances: PackedFloat32Array = PackedFloat32Array()
+	for y: int in range(origin.y, origin.y + region):
+		for x: int in range(origin.x, origin.x + region):
+			luminances.append(image.get_pixel(x, y).get_luminance())
+	if luminances.is_empty():
+		return 0.0
+	luminances.sort()
+	var take: int = maxi(1, int(float(luminances.size()) * TOP_FRACTION))
+	var total: float = 0.0
+	for index: int in range(luminances.size() - take, luminances.size()):
+		total += luminances[index]
+	return total / float(take)
+
+
+func _chunk_material(chunk: Vector2i) -> ShaderMaterial:
+	var suffix: String = ":%d:%d" % [chunk.x, chunk.y]
+	for key: String in subject.terrain_mesh_nodes.keys():
+		if not key.ends_with(suffix):
+			continue
+		var node: MeshInstance3D = subject.terrain_mesh_nodes[key] as MeshInstance3D
+		if node.mesh.get_surface_count() == 0:
+			continue
+		return node.mesh.surface_get_material(0) as ShaderMaterial
+	return null
+
+
+func _spawn_torch_at(anchor: Vector2i) -> Dictionary:
+	# The native queue deduplicates candidates closer than 10 source units, so a
+	# stale entry would swallow the next attempt.
+	subject.torch_runtime.queue.clear()
+	var worker: Node3D = subject.dwarf_nodes[0]
+	worker.position = Vector3(float(anchor.x) + 0.5, -(float(anchor.y) + 0.5), 14.0)
+	var actor_id: int = int(worker.get_meta("autolight_host_id"))
+	var before_count: int = subject.torch_runtime.torches.size()
+	# AUTO.scheduled: tick > 10, tick % 4 == 1, (tick >> 2) % 4 == actor_id % 4.
+	subject.torch_runtime.tick = 1 + 4 * (actor_id % 4) + 16
+	for pass_index: int in range(3):
+		subject._update_automatic_torches(0.0)
+	if subject.torch_runtime.torches.size() <= before_count:
+		return {}
+	var torch: Dictionary = subject.torch_runtime.torches[subject.torch_runtime.torches.size() - 1]
+	var source: Vector3 = torch["position"]
+	var local: Vector3 = subject.native_world.to_local(source)
+	return {"id": int(torch["id"]), "source": source, "local": local,
+		"chunk": Vector2i(floori(local.x / 8.0), floori(local.y / 8.0)),
+		"light_index": int(torch["light_index"])}
+
+
+func _finish() -> void:
+	subject.queue_free()
+	await process_frame
+	print("TORCH_RENDER_VISIBLE_SELF_TEST torches=%d checks=%d failures=%d" % [
+		torches.size(), checks, failures])
+	quit(0 if failures == 0 else 1)
