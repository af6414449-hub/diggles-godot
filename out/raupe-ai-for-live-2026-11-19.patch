+extends SceneTree
+## --headless --path godot --script res://tools/native_raupe_ai_self_test.gd
+## Checks the ported Raupe rules: the variant table, the geometry helpers, the
+## free and farmed roaming, the plant search cadence and the attack values.
+##
+## Sources (original install, data/Scripts/classes/characters/raupe.tcl).
+const Raupe = preload("res://scripts/native_raupe_ai.gd")
+
+var _checks: int = 0
+var _failures: Array[String] = []
+
+
+func _initialize() -> void:
+	call_deferred("_run")
+
+
+func _check(condition: bool, message: String) -> void:
+	_checks += 1
+	if not condition:
+		_failures.append(message)
+		printerr("FAIL: " + message)
+
+
+func _run() -> void:
+	# --- variant and class data (raupe.tcl:31-58) -----------------------------
+	_check(Raupe.variant_tag(1) == "01", "a one digit variant gets a leading zero")
+	_check(Raupe.variant_tag(13) == "13", "a two digit variant stays as it is")
+	_check(Raupe.attack_type(2) == 1, "type 02 is a plant eater")
+	_check(Raupe.attack_type(6) == 1, "type 06 is a plant eater")
+	_check(Raupe.attack_type(7) == 1, "type 07 is a plant eater")
+	_check(Raupe.attack_type(8) == 1, "type 08 is a plant eater")
+	_check(Raupe.attack_type(1) == 0, "type 01 does not eat plants")
+	_check(Raupe.attack_type(5) == 0, "type 05 does not eat plants")
+	_check(Raupe.attack_type(13) == 0, "type 13 does not eat plants")
+	_check(Raupe.is_predatory(8) and not Raupe.is_predatory(9), "only four of the thirteen types are predatory")
+	_check(Raupe.HITPOINTS == 0.02, "the Raupe starts with 0.02 hit points")
+	_check(Raupe.WEIGHT == 0.01, "the Raupe weighs 0.01")
+	_check(Raupe.DEATH_THRESHOLD == 0.01, "the Raupe dies below 0.01 hit points")
+	_check(Raupe.MOVE_SPEED == 0.03, "the move action runs with speed 0.03")
+
+	# --- geometry (raupe.tcl:64, :91, :277-284) -------------------------------
+	var zero := Vector3.ZERO
+	_check(Raupe.vector_xz(0.0, 2.0) == Vector3(0.0, 0.0, 2.0), "a zero angle points along z")
+	_check(Raupe.vector_xz(PI * 0.5, 1.0).is_equal_approx(Vector3(1.0, 0.0, 0.0)), "a quarter turn points along x")
+	_check(absf(Raupe.angle_xz(zero, Vector3(0.0, 0.0, 5.0))) < 0.0001, "a target along z has the angle zero")
+	_check(absf(Raupe.angle_xz(zero, Vector3(5.0, 0.0, 0.0)) - PI * 0.5) < 0.0001, "a target along x has a quarter turn angle")
+	_check(absf(Raupe.yaw_towards(zero, Vector3(0.0, 0.0, 5.0)) + 1.57) < 0.0001, "the yaw towards a target is shifted by 1.57")
+	_check(absf(Raupe.yaw_away(zero, Vector3(0.0, 0.0, 5.0)) - 1.57) < 0.0001, "the yaw away from a target is shifted the other way")
+	_check(Raupe.FARM_BOX == Vector3(2.0, 0.5, 3.0), "the farm query box is two by three")
+	_check(Raupe.GNOME_BOX == Vector3(3.0, 0.5, 5.0), "the dwarf query box is three by five")
+
+	# --- free roaming (raupe.tcl:67-85) ---------------------------------------
+	_check(absf(Raupe.free_turn(0.0, 0.0) - 1.57) < 0.0001, "the free turn starts at a quarter turn")
+	_check(absf(Raupe.free_turn(0.0, 0.5) - 2.07) < 0.0001, "the free turn carries the jitter")
+	_check(absf(Raupe.free_reverse(1.0, 0.1) - 4.14) < 0.0001, "a low roll reverses the turn")
+	_check(absf(Raupe.free_reverse(1.0, 0.5) - 1.0) < 0.0001, "a high roll keeps the turn")
+	_check(Raupe.free_candidate(zero, 0.0, 2.0) == Vector3(0.0, 0.0, 2.0), "the roaming candidate is two units ahead")
+	var request := Raupe.free_place_request(zero, Vector3(0.0, 0.0, 3.0))
+	_check((request["center"] as Vector3) == Vector3(0.0, 0.0, 3.0), "the free place search is centred on the candidate")
+	_check(int(request["circle"]) == 3, "the free place search uses a radius of three")
+	_check((request["nearpos"] as Vector3) == zero, "the free place search starts at the own position")
+	_check(int(request["random"]) == 2, "the free place search randomises by two")
+	_check(Raupe.FOW_MIN == 10.0, "the free roaming needs a visibility of ten")
+	_check(Raupe.WAIT_NO_PLACE == 3.0, "a failed place search waits three seconds")
+
+	# --- farm pen (raupe.tcl:87-115) ------------------------------------------
+	var farm_position := Vector3(10.0, 0.0, 0.0)
+	var rectangle := Raupe.farm_rectangle(farm_position, farm_position)
+	_check(absf(rectangle[0] + 2.0) < 0.0001, "the farm rectangle starts two units before the farm")
+	_check(absf(rectangle[1] + 3.0) < 0.0001, "the farm rectangle starts three units before the farm")
+	_check(absf(rectangle[2] - 1.5) < 0.0001, "the farm rectangle ends one and a half units after the farm")
+	_check(absf(rectangle[3] - 3.0) < 0.0001, "the farm rectangle ends three units after the farm")
+	var shifted := Raupe.farm_rectangle(farm_position, Vector3(12.0, 0.0, 0.0))
+	_check(absf((shifted[0] + 12.0) - 8.0) < 0.0001, "the rectangle follows the centre it is given")
+	_check(absf((shifted[2] + 12.0) - 11.5) < 0.0001, "the shifted rectangle keeps its width")
+	var farm_request := Raupe.farm_place_request(farm_position, Vector3(12.0, 0.0, 0.0), true, zero)
+	_check((farm_request["center"] as Vector3) == Vector3(12.0, 0.0, 0.0), "the farm place search is centred on the dwarf")
+	_check(farm_request.has("nearpos"), "a nearby dwarf keeps the own position as the near position")
+	_check(absf(float(farm_request["mindist"]) - 0.6) < 0.0001, "the farm place search keeps a distance of 0.6")
+	_check(int(farm_request["random"]) == 2, "the farm place search randomises by two")
+	var farm_request_without := Raupe.farm_place_request(farm_position, zero, false, zero)
+	_check(not farm_request_without.has("nearpos"), "without a dwarf there is no near position")
+
+	# --- plant search (raupe.tcl:117-146) -------------------------------------
+	var step := Raupe.attack_counter_step(0)
+	_check(int(step["counter"]) == 1 and not bool(step["search"]), "the first search counts up")
+	step = Raupe.attack_counter_step(9)
+	_check(int(step["counter"]) == 10 and not bool(step["search"]), "the tenth count still waits")
+	step = Raupe.attack_counter_step(10)
+	_check(int(step["counter"]) == 0 and bool(step["search"]), "the eleventh count searches and resets")
+	_check(Raupe.PLANT_RANGE == 8.0, "the plant search reaches eight units")
+	_check(Raupe.APPROACH_RANGE == 5.0, "a plant beyond five units needs an approach")
+	_check(Raupe.APPROACH_MIN_DISTANCE == 2.0, "the approach point keeps two units from the plant")
+	var plant_request := Raupe.plant_place_request(Vector3(0.0, 0.0, 4.0), zero)
+	_check((plant_request["center"] as Vector3) == Vector3(0.0, 0.0, 4.0), "the approach is centred on the plant")
+	_check(absf(float(plant_request["mindist"]) - 2.0) < 0.0001, "the approach keeps two units from the plant")
+	_check((plant_request["nearpos"] as Vector3) == zero, "the approach starts at the own position")
+
+	# --- the attack (raupe.tcl:253-319) ---------------------------------------
+	_check(Raupe.attack_frame(0) == 5, "the first windup frame is five")
+	_check(Raupe.attack_frame(1) == 9, "the second windup frame is nine")
+	_check(absf(Raupe.windup_seconds(5) - 0.5) < 0.0001, "frame five waits half a second")
+	_check(absf(Raupe.windup_seconds(9) - 0.9) < 0.0001, "frame nine waits nine tenths of a second")
+	_check(absf(Raupe.ATTACK_DISTANCE - 0.55) < 0.0001, "the attack closes to 0.55")
+	_check(absf(Raupe.ATTACK_DISTANCE_TOLERANCE - 0.1) < 0.0001, "the attack tolerance is 0.1")
+	_check(Raupe.approach_finished(0.5), "a distance of 0.5 is close enough")
+	_check(Raupe.approach_finished(0.55), "a distance of 0.55 is close enough")
+	_check(not Raupe.approach_finished(0.4), "a distance of 0.4 is too far")
+	_check(not Raupe.approach_finished(0.7), "a distance of 0.7 is too far")
+	_check(Raupe.approach_point(zero, 0.0) == Vector3(0.0, 0.0, 0.55), "the approach point is 0.55 from the plant")
+	_check(absf(Raupe.PLANT_DAMAGE - 0.03) < 0.0001, "the attack takes 0.03 from the plant")
+	_check(absf(Raupe.SELF_DAMAGE - 0.05) < 0.0001, "the attack takes 0.05 from the Raupe")
+	_check(Raupe.PARTICLE_SOURCE == 15, "the attack uses particle source fifteen")
+	var particle := Raupe.attack_particle(zero, 0.0)
+	_check(absf(float((particle["direction"] as Vector3).y) + 0.02) < 0.0001, "the particles point slightly down")
+	_check(absf((particle["position"] as Vector3).z - 0.3) < 0.0001, "the particles sit fifteen units along the direction")
+	_check(int(particle["source"]) == 15, "the particle request keeps the source")
+
+	# --- waits and states ----------------------------------------------------
+	_check(Raupe.farmed_wait(0.04), "a low roll makes the farmed Raupe wait")
+	_check(not Raupe.farmed_wait(0.06), "a high roll lets the farmed Raupe roam")
+	_check(absf(Raupe.WAIT_FARMED - 1.0) < 0.0001, "the farmed wait is one second")
+	_check(absf(Raupe.WAIT_CONTAINED - 4.0) < 0.0001, "the contained wait is four seconds")
+	_check(Raupe.STATE_FREE == "free" and Raupe.STATE_FARMED == "farmed", "the state names match the original")
+	_check(Raupe.STATE_CONTAINED == "contained" and Raupe.STATE_PLANT_ATTACK == "plant_attack", "the remaining state names match")
+	_check(not Raupe.place_failed(0, 0), "a free place with code zero is good enough")
+	_check(Raupe.place_failed(-1, 0), "a negative code is no place")
+	_check(Raupe.place_failed(0, 1), "code zero is not enough for the farm")
+	_check(not Raupe.place_failed(1, 1), "code one is enough for the farm")
+	_check(Raupe.place_failed(0, 1), "code zero is not enough for the approach")
+
+	# --- animation aliases (raupe.tcl:8-20) ----------------------------------
+	var still := Raupe.anim_clip(2, Raupe.ANIM_WAIT)
+	_check(String(still["clip"]) == "raupe02.standard", "the still clip carries the type")
+	_check(int(still["frame"]) == 0, "the still clip starts at frame zero")
+	var crawl := Raupe.anim_clip(2, Raupe.ANIM_CRAWL, 5)
+	_check(String(crawl["clip"]) == "raupe02.kriechen", "the crawl clip carries the type")
+	_check(int(crawl["frame"]) == 5, "the crawl clip can hold a frame")
+
+	if _failures.is_empty():
+		print("NATIVE_RAUPE_AI_SELF_TEST_OK assertions=%d" % _checks)
+	else:
+		printerr("NATIVE_RAUPE_AI_SELF_TEST_FAIL failures=%d" % _failures.size())
+	quit(0 if _failures.is_empty() else 1)

