diff --git a/scripts/diggles_campaign_composer.gd b/scripts/diggles_campaign_composer.gd
new file mode 100644
--- /dev/null
+++ b/scripts/diggles_campaign_composer.gd
@@ -0,0 +1,181 @@
+extends RefCounted
+## Composer for the Urwald campaign level.
+##
+## It overlays the PMP geometry and the L2M material layer of every placed
+## template onto the level grid and places the template objects with their
+## native flags, then applies the post-processing of the original campaign
+## script.
+##
+## FACT (source: data/Scripts/gameplay/Campaign.tcl, read-only):
+##   * line 2   - the level is a 512 x 640 map.
+##   * line 12  - the start template `urw_unq_start` is placed at (208, 0).
+##   * lines 13-15 - the cave painting contributes its material layer only:
+##                  `map_setlayer2 30 23 data/templates/urw_unq_hoehlenmalerei.l2m`.
+##   * lines 178-190 - every template of the placement list is stamped with
+##                  `sm_mark_temparea`, `call data/templates/<name>.tcl` and
+##                  `MapTemplateSet <x> <y>`.
+##   * lines 198-203 - every object of class `Wuker` is deleted.
+##   * lines 205-209 - a `FogRemover` is created at (239, 14, 15) with
+##                  `fog_remove 0 46 22` and `set_undeletable 1`.
+
+const TEMPLATES := preload("res://scripts/diggles_campaign_templates.gd")
+
+const MAP_WIDTH: int = 512
+const MAP_HEIGHT: int = 640
+const START_TEMPLATE: String = "urw_unq_start"
+const START_X: int = 208
+const START_Y: int = 0
+const CAVE_PAINTING_TEMPLATE: String = "urw_unq_hoehlenmalerei"
+const CAVE_PAINTING_X: int = 30
+const CAVE_PAINTING_Y: int = 23
+const REMOVED_CLASS: String = "Wuker"
+const FOG_POSITION: Vector3i = Vector3i(239, 14, 15)
+const FOG_RECT: Vector3i = Vector3i(0, 46, 22)
+
+
+## Compose a full level from the placement list of the generator.
+func compose(placements: Array[Dictionary], templates: TEMPLATES) -> Dictionary:
+	var size: Vector2i = Vector2i(MAP_WIDTH, MAP_HEIGHT)
+	var cells: Dictionary = {}
+	var layer2: PackedInt32Array = PackedInt32Array()
+	layer2.resize(size.x * size.y)
+	var objects: Array[Dictionary] = []
+	var stamped: Array[Dictionary] = []
+
+	# Campaign.tcl:12 - the start template carries the player dwarves.
+	_stamp(templates, START_TEMPLATE, START_X, START_Y, cells, layer2, size, objects, stamped, true)
+	# Campaign.tcl:13-15 - the cave painting contributes the material layer only.
+	_stamp(templates, CAVE_PAINTING_TEMPLATE, CAVE_PAINTING_X, CAVE_PAINTING_Y,
+			cells, layer2, size, objects, stamped, false)
+
+	for placement: Dictionary in placements:
+		_stamp(templates, str(placement["template"]), int(placement["x"]), int(placement["y"]),
+				cells, layer2, size, objects, stamped, true)
+
+	# Campaign.tcl:198-203 - every Wuker object is deleted after the build.
+	var kept: Array[Dictionary] = []
+	var removed: Array[Dictionary] = []
+	for object: Dictionary in objects:
+		if str(object["class"]) == REMOVED_CLASS:
+			removed.append(object)
+		else:
+			kept.append(object)
+
+	var ordered_cells: Array[Dictionary] = []
+	for key: Variant in cells.keys():
+		ordered_cells.append(cells[key])
+	ordered_cells.sort_custom(func(a: Dictionary, b: Dictionary) -> bool:
+		if int(a["y"]) == int(b["y"]):
+			return int(a["x"]) < int(b["x"])
+		return int(a["y"]) < int(b["y"]))
+
+	return {
+		"size": size,
+		"cells": ordered_cells,
+		"layer2_words": layer2,
+		"objects": kept,
+		"removed_objects": removed,
+		"placements": stamped,
+		"fog": {
+			"position": FOG_POSITION,
+			"rect": FOG_RECT,
+			"undeletable": true,
+		},
+		"removed_classes": [REMOVED_CLASS],
+	}
+
+
+func _stamp(templates: TEMPLATES, template_name: String, origin_x: int, origin_y: int,
+		cells: Dictionary, layer2: PackedInt32Array, size: Vector2i,
+		objects: Array[Dictionary], stamped: Array[Dictionary], with_geometry: bool) -> void:
+	var template: Dictionary = templates.get_template(template_name)
+	if template.is_empty():
+		stamped.append({"template": template_name, "x": origin_x, "y": origin_y, "resolved": false})
+		return
+	if with_geometry and template.has("pmp"):
+		_stamp_geometry(template, origin_x, origin_y, cells, size)
+	if template.has("l2m"):
+		_stamp_layer(template, origin_x, origin_y, layer2, size)
+	if with_geometry:
+		for object: Dictionary in template.get("objects", []):
+			objects.append(_place_object(object, template_name, origin_x, origin_y))
+	stamped.append({
+		"template": template_name,
+		"x": origin_x,
+		"y": origin_y,
+		"resolved": true,
+		"geometry": with_geometry and template.has("pmp"),
+		"material": template.has("l2m"),
+	})
+
+
+func _stamp_geometry(template: Dictionary, origin_x: int, origin_y: int,
+		cells: Dictionary, size: Vector2i) -> void:
+	var pmp: Dictionary = template["pmp"]
+	var width: int = int(pmp["width"])
+	var height: int = int(pmp["height"])
+	var blocks: PackedInt32Array = pmp["blocks"]
+	var flags: PackedByteArray = pmp["flags"]
+	var attributes: PackedByteArray = pmp["attributes"]
+	for row: int in range(height):
+		for column: int in range(width):
+			if not _has_geometry(flags, width, height, row, column):
+				continue
+			var index: int = row * width + column
+			var cell_x: int = origin_x + column
+			var cell_y: int = origin_y + row
+			if cell_x < 0 or cell_y < 0 or cell_x >= size.x or cell_y >= size.y:
+				continue
+			cells[Vector2i(cell_x, cell_y)] = {
+				"x": cell_x,
+				"y": cell_y,
+				"block": blocks[index],
+				"flags": flags[index],
+				"cell_attribute": attributes[index],
+				"template": str(template["name"]),
+			}
+
+
+## The native loader combines four neighbouring flag samples and skips a cell
+## whose neighbourhood is empty (Diggles.exe 0x599A92..0x599B3E).
+func _has_geometry(flags: PackedByteArray, width: int, height: int, row: int, column: int) -> bool:
+	for offset: Vector2i in [Vector2i.ZERO, Vector2i.RIGHT, Vector2i.DOWN, Vector2i.ONE]:
+		var sample_x: int = column + offset.x
+		var sample_y: int = row + offset.y
+		if sample_x >= width or sample_y >= height:
+			continue
+		if (flags[sample_y * width + sample_x] & 0x7F) != 0:
+			return true
+	return false
+
+
+func _stamp_layer(template: Dictionary, origin_x: int, origin_y: int,
+		layer2: PackedInt32Array, size: Vector2i) -> void:
+	var l2m: Dictionary = template["l2m"]
+	var width: int = int(l2m["width"])
+	var height: int = int(l2m["height"])
+	var words: PackedInt32Array = l2m["words"]
+	for row: int in range(height):
+		for column: int in range(width):
+			var cell_x: int = origin_x + column
+			var cell_y: int = origin_y + row
+			if cell_x < 0 or cell_y < 0 or cell_x >= size.x or cell_y >= size.y:
+				continue
+			layer2[cell_y * size.x + cell_x] = words[row * width + column]
+
+
+func _place_object(source: Dictionary, template_name: String, origin_x: int, origin_y: int) -> Dictionary:
+	var flags: Dictionary = source.get("flags", {})
+	return {
+		"class": str(source["class"]),
+		"x": float(source["x"]) + float(origin_x),
+		"y": float(source["y"]) + float(origin_y),
+		"z": float(source["z"]),
+		"rotation": source.get("rotation", []),
+		"owner": flags.get("owner", null),
+		"physic": flags.get("physic", null),
+		"autolight": flags.get("autolight", null),
+		"boxed": flags.get("boxed", null),
+		"info": source.get("info", {}),
+		"template": template_name,
+	}

diff --git a/scripts/diggles_campaign_generator.gd b/scripts/diggles_campaign_generator.gd
new file mode 100644
--- /dev/null
+++ b/scripts/diggles_campaign_generator.gd
@@ -0,0 +1,222 @@
+extends RefCounted
+## Urwald campaign level generator, ported from `Campaign.tcl:first_level`.
+##
+## FACT (source: data/Scripts/gameplay/Campaign.tcl, read-only):
+##   * lines 22-191 define `proc first_level {startx starty}` and build the level
+##     from five tables plus a random draw order.
+##   * The tables below are transcribed verbatim from lines 24-100.
+##   * The draw order below follows lines 101-175 exactly, including the order
+##     in which the random values are consumed.
+##   * The random values come from the native `irandom` command, reproduced by
+##     `res://scripts/diggles_irandom.gd`.
+##
+## Every table entry keeps the original comment marker index where the source
+## carries one, so a reader can match the port against the original file.
+
+const RNG := preload("res://scripts/diggles_irandom.gd")
+
+## Campaign.tcl:26-30 - cave templates with their x/y offset.
+const CAVE_LIST: Array = [
+	{"name": "urw_hol_001_a", "x": 20, "y": 4},
+	{"name": "urw_hol_014_b", "x": 20, "y": 12},
+	{"name": "urw_hol_018_c", "x": 28, "y": 16},
+	{"name": "urw_hol_019_b", "x": 24, "y": 16},
+	{"name": "urw_hol_027_a", "x": 16, "y": 4},
+]
+
+## Campaign.tcl:33-46 - cave pairs and their y shift list.
+const COMB_LIST: Array = [
+	{"left": 0, "right": 1, "y_offsets": [0]},
+	{"left": 0, "right": 2, "y_offsets": [0]},
+	{"left": 0, "right": 4, "y_offsets": [0]},
+	{"left": 1, "right": 0, "y_offsets": [4]},
+	{"left": 1, "right": 3, "y_offsets": [4]},
+	{"left": 4, "right": 0, "y_offsets": [0]},
+	{"left": 4, "right": 2, "y_offsets": [0]},
+	{"left": 4, "right": 3, "y_offsets": [0]},
+]
+
+## Campaign.tcl:50-52 - tunnel templates with their x/y offset.
+const TUNN_LIST: Array = [
+	{"name": "urw_gng_013_", "x": 4, "y": 0},
+	{"name": "urw_gng_002_", "x": 8, "y": 0},
+	{"name": "urw_gng_003_", "x": 12, "y": 0},
+]
+
+## Campaign.tcl:55-60 - connection schemes; the first element shifts std_x.
+const CON_LIST: Array = [
+	[0, 0, 1, 2],
+	[0, 0, 2, 1],
+	[0, 1, 0, 2],
+	[4, 2, 0, 1],
+	[4, 2, 1, 0],
+	[4, 1, 2, 0],
+]
+
+## Campaign.tcl:64-85 - voodoo templates with their variant letters.
+const VODO_LIST: Array = [
+	{"name": "urw_gng_001_", "letters": "ab"},
+	{"name": "urw_gng_007_", "letters": "abcd"},
+	{"name": "urw_gng_008_", "letters": "abc"},
+	{"name": "urw_gng_009_", "letters": "abcd"},
+	{"name": "urw_gng_012_", "letters": "abcd"},
+	{"name": "urw_gng_019_", "letters": "abc"},
+	{"name": "urw_gng_022_", "letters": "abdeg"},
+	{"name": "urw_gng_023_", "letters": "abc"},
+	{"name": "urw_gng_026_", "letters": "abc"},
+	{"name": "urw_gng_028_", "letters": "bcd"},
+	{"name": "urw_gng_030_", "letters": "a"},
+	{"name": "urw_gng_032_", "letters": "ab"},
+	{"name": "urw_gng_034_", "letters": "acdfhk"},
+	{"name": "urw_gng_039_", "letters": "ab"},
+	{"name": "urw_gng_042_", "letters": "ab"},
+	{"name": "urw_gng_045_", "letters": "ab"},
+	{"name": "urw_unq_vodo_001_", "letters": "a"},
+	{"name": "urw_gng_004_", "letters": "ab"},
+	{"name": "urw_gng_027_", "letters": "abc"},
+	{"name": "urw_gng_036_", "letters": "ab"},
+	{"name": "urw_gng_043_", "letters": "ab"},
+	{"name": "urw_gng_044_", "letters": "ab"},
+]
+
+## Campaign.tcl:88-95 - voodoo chains used when the connection index is >= 4.
+const VOCON_LIST_1: Array = [
+	[[3, 20, 0], [8, 8, 12], [5, 20, 12], [6, 24, 12], [16, -24, 12]],
+	[[1, 20, 0], [13, 4, 16], [7, 4, 28], [9, 12, 4], [16, -28, 12]],
+	[[2, 20, 0], [5, 20, 8], [6, 24, 8], [15, 8, 8], [12, 4, 16], [6, 16, 24], [16, -28, 12]],
+	[[2, 20, 0], [14, 12, 8], [4, 8, 12], [13, 0, 16], [7, 0, 28], [16, -32, 12]],
+	[[2, 20, 0], [11, 0, 16], [15, 8, 8], [5, 20, 8], [6, 24, 8], [7, 8, 28], [16, -32, 12]],
+	[[1, 20, 0], [6, 16, 20], [4, 8, 8], [14, 12, 4], [10, 4, 12], [16, -28, 12]],
+]
+
+## Campaign.tcl:98-100 - voodoo chains used when the connection index is < 2.
+const VOCON_LIST_2: Array = [
+	[[18, 20, 0], [0, 20, 20], [10, 24, 12], [6, 36, 20], [16, -12, 12]],
+	[[20, 20, 0], [21, 32, 4], [17, 20, 20], [10, 36, 12], [6, 48, 20], [16, -12, 12]],
+	[[19, 20, 0], [1, 24, 12], [14, 16, 16], [6, 32, 8], [16, -16, 12]],
+]
+
+## Campaign.tcl:102 - letter pool of the left tunnel end, indexed by present_side.
+const LEFT_LETTERS: Array = ["abdef", "cgih"]
+
+## Campaign.tcl:103 - letter pool of the right tunnel end, indexed by present_side.
+const RIGHT_LETTERS: Array = ["cfkh", "abdeg"]
+
+## Campaign.tcl:156-160 - the tunnel suffix uses two letters only for urw_gng_002_.
+const TWO_LETTER_TUNNEL: String = "urw_gng_002_"
+const LETTERS_AB: String = "ab"
+const LETTERS_ABC: String = "abc"
+
+
+## Build the template placement list of one Urwald level.
+##
+## `start_x` and `start_y` are the `first_level` arguments; the original calls
+## `first_level 208 0` (Campaign.tcl:195).
+func first_level(start_x: int, start_y: int, seed_value: int) -> Dictionary:
+	var rng: RNG = RNG.new(seed_value)
+	var placements: Array[Dictionary] = []
+
+	# Campaign.tcl:101-103 - present side and its letter pools.
+	var present_side: int = rng.irandom(2)
+	var left_letters: String = LEFT_LETTERS[present_side]
+	var right_letters: String = RIGHT_LETTERS[present_side]
+
+	# Campaign.tcl:104-105 - the standard placement origin.
+	var std_x: int = start_x + 36
+	var std_y: int = start_y + 40
+
+	# Campaign.tcl:109-111 - cave pair and its y shift.
+	var comb_index: int = rng.irandom(COMB_LIST.size())
+	var comb: Dictionary = COMB_LIST[comb_index]
+	var y_offsets: Array = comb["y_offsets"]
+	std_y += int(y_offsets[rng.irandom(y_offsets.size())])
+
+	# Campaign.tcl:112-114 - connection scheme; `lrem conn 0` removes the first
+	# element, shifts std_x by it and leaves the three tunnel indices behind.
+	var conn_index: int = rng.irandom(CON_LIST.size())
+	var conn_entry: Array = CON_LIST[conn_index]
+	var conn: Array = conn_entry.duplicate()
+	std_x += int(conn.pop_front())
+
+	# Campaign.tcl:115-124 - the voodoo chain pool depends on the connection.
+	var vocon_list: Array = []
+	if conn_index < 2:
+		vocon_list = VOCON_LIST_2
+	elif conn_index < 4:
+		vocon_list = VOCON_LIST_1.duplicate()
+		vocon_list.append_array(VOCON_LIST_2)
+	else:
+		vocon_list = VOCON_LIST_1
+	var vodo: Array = vocon_list[rng.irandom(vocon_list.size())]
+
+	# Campaign.tcl:128-134 - left cave plus its tunnel end.
+	var left_cave: Dictionary = CAVE_LIST[int(comb["left"])]
+	placements.append({
+		"template": str(left_cave["name"]),
+		"x": std_x - int(left_cave["x"]),
+		"y": std_y - int(left_cave["y"]),
+	})
+	var left_letter: String = left_letters[rng.irandom(left_letters.length())]
+	placements.append({
+		"template": "urw_gng_021_" + left_letter,
+		"x": std_x - int(left_cave["x"]) - 4,
+		"y": std_y,
+	})
+
+	# Campaign.tcl:137-143 - right cave plus its tunnel end.
+	var right_cave: Dictionary = CAVE_LIST[int(comb["right"])]
+	placements.append({
+		"template": str(right_cave["name"]),
+		"x": std_x + 24,
+		"y": std_y - int(right_cave["y"]),
+	})
+	var right_letter: String = right_letters[rng.irandom(right_letters.length())]
+	placements.append({
+		"template": "urw_gng_022_" + right_letter,
+		"x": std_x + int(right_cave["x"]) + 24,
+		"y": std_y,
+	})
+
+	# Campaign.tcl:146-163 - the tunnel chain. The voodoo origin is taken from
+	# the first connection element, where x is still the unshifted std_x.
+	var tunnel_x: int = std_x
+	var vodo_x: int = std_x - 20
+	var vodo_y: int = std_y + 4
+	for element: int in conn:
+		if element == 0:
+			vodo_x = tunnel_x - 20
+			vodo_y = std_y + 4
+		var tunnel: Dictionary = TUNN_LIST[element]
+		var template_name: String = str(tunnel["name"])
+		var suffix_pool: String = LETTERS_AB if template_name == TWO_LETTER_TUNNEL else LETTERS_ABC
+		var suffix: String = suffix_pool[rng.irandom(suffix_pool.length())]
+		placements.append({
+			"template": template_name + suffix,
+			"x": tunnel_x,
+			"y": std_y + int(tunnel["y"]),
+		})
+		tunnel_x += int(tunnel["x"])
+
+	# Campaign.tcl:166-174 - the voodoo chain.
+	for entry: Array in vodo:
+		var voodoo: Dictionary = VODO_LIST[int(entry[0])]
+		var letters: String = str(voodoo["letters"])
+		var letter: String = letters[rng.irandom(letters.length())]
+		placements.append({
+			"template": str(voodoo["name"]) + letter,
+			"x": vodo_x + int(entry[1]),
+			"y": vodo_y + int(entry[2]),
+		})
+
+	return {
+		"seed": seed_value,
+		"start": {"x": start_x, "y": start_y},
+		"placements": placements,
+		"selection": {
+			"present_side": present_side,
+			"comb_index": comb_index,
+			"conn_index": conn_index,
+			"vodo_chain_count": vocon_list.size(),
+			"vodo_chain": vodo,
+		},
+	}

diff --git a/scripts/diggles_campaign_scene.gd b/scripts/diggles_campaign_scene.gd
new file mode 100644
--- /dev/null
+++ b/scripts/diggles_campaign_scene.gd
@@ -0,0 +1,108 @@
+extends RefCounted
+## Builds a Godot scene from a composed Urwald campaign level.
+##
+## The scene presents three things:
+##   * the composed terrain cell grid, one quad per native cell, tinted by the
+##     L2M material word that the composer wrote into the layer,
+##   * one node per composed template object, carrying the native class, the
+##     owner/physic/autolight/boxed flags and the source template,
+##   * the `FogRemover` of Campaign.tcl:205-209.
+##
+## The native block meshes of the BlockDB are not part of this module: the
+## composed level references 1229 native block ids and the live project only
+## carries the mesh table of its own start template. The terrain quads are a
+## level-preview adapter, not a renderer of the native geometry.
+
+
+static func build(level: Dictionary) -> Node3D:
+	var root: Node3D = Node3D.new()
+	root.name = "CampaignLevel"
+	root.add_child(_build_terrain(level))
+	root.add_child(_build_objects(level))
+	root.add_child(_build_fog(level))
+	return root
+
+
+static func _build_terrain(level: Dictionary) -> MeshInstance3D:
+	var size: Vector2i = level["size"]
+	var layer2: PackedInt32Array = level["layer2_words"]
+	var cells: Array = level["cells"]
+	var positions: PackedVector3Array = PackedVector3Array()
+	var colors: PackedColorArray = PackedColorArray()
+	var indices: PackedInt32Array = PackedInt32Array()
+	for cell: Dictionary in cells:
+		var cell_x: int = int(cell["x"])
+		var cell_y: int = int(cell["y"])
+		var index: int = cell_y * size.x + cell_x
+		var word: int = layer2[index] if index < layer2.size() else 0
+		var corner: int = indices.size()
+		positions.append(Vector3(cell_x, -cell_y, 0.0))
+		positions.append(Vector3(cell_x + 1.0, -cell_y, 0.0))
+		positions.append(Vector3(cell_x, -cell_y - 1.0, 0.0))
+		positions.append(Vector3(cell_x + 1.0, -cell_y - 1.0, 0.0))
+		var tint: Color = material_tint(word)
+		for _corner: int in range(4):
+			colors.append(tint)
+		indices.append(corner)
+		indices.append(corner + 2)
+		indices.append(corner + 1)
+		indices.append(corner + 1)
+		indices.append(corner + 2)
+		indices.append(corner + 3)
+	var arrays: Array = []
+	arrays.resize(Mesh.ARRAY_MAX)
+	arrays[Mesh.ARRAY_VERTEX] = positions
+	arrays[Mesh.ARRAY_COLOR] = colors
+	arrays[Mesh.ARRAY_INDEX] = indices
+	var mesh: ArrayMesh = ArrayMesh.new()
+	mesh.add_surface_from_arrays(Mesh.PRIMITIVE_TRIANGLES, arrays)
+	var instance: MeshInstance3D = MeshInstance3D.new()
+	instance.name = "CampaignTerrain"
+	instance.mesh = mesh
+	instance.set_meta("native_cell_count", cells.size())
+	return instance
+
+
+## Preview tint of one L2M word. A zero word is plain ground; every other
+## word carries a nonzero 4-bit detail mask in one of its nibbles.
+static func material_tint(word: int) -> Color:
+	if word == 0:
+		return Color(0.45, 0.42, 0.38)
+	var mask: int = 0
+	for nibble: int in range(4):
+		if ((word >> (4 * nibble)) & 0xF) != 0:
+			mask = mask | (1 << nibble)
+	var red: float = 0.30 + 0.12 * float(mask & 1)
+	var green: float = 0.32 + 0.10 * float((mask >> 1) & 1)
+	var blue: float = 0.34 + 0.08 * float((mask >> 2) & 1)
+	return Color(red, green, blue)
+
+
+static func _build_objects(level: Dictionary) -> Node3D:
+	var parent: Node3D = Node3D.new()
+	parent.name = "CampaignObjects"
+	var index: int = 0
+	for object: Dictionary in level["objects"]:
+		var node: Node3D = Node3D.new()
+		node.name = "%s_%03d" % [str(object["class"]), index]
+		node.position = Vector3(float(object["x"]), -float(object["y"]), float(object["z"]))
+		node.set_meta("native_class", str(object["class"]))
+		node.set_meta("native_owner", object["owner"])
+		node.set_meta("native_physic", object["physic"])
+		node.set_meta("native_autolight", object["autolight"])
+		node.set_meta("native_boxed", object["boxed"])
+		node.set_meta("native_template", str(object["template"]))
+		parent.add_child(node)
+		index += 1
+	return parent
+
+
+static func _build_fog(level: Dictionary) -> Node3D:
+	var fog: Dictionary = level["fog"]
+	var position: Vector3i = fog["position"]
+	var node: Node3D = Node3D.new()
+	node.name = "FogRemover"
+	node.position = Vector3(float(position.x), -float(position.y), float(position.z))
+	node.set_meta("native_fog_remove", fog["rect"])
+	node.set_meta("native_undeletable", fog["undeletable"])
+	return node

diff --git a/scripts/diggles_campaign_templates.gd b/scripts/diggles_campaign_templates.gd
new file mode 100644
--- /dev/null
+++ b/scripts/diggles_campaign_templates.gd
@@ -0,0 +1,86 @@
+extends RefCounted
+## Loader for the Urwald template manifest of the campaign level generator.
+##
+## The manifest is produced offline from the original game data by
+## `tools/extract_campaign_templates.py` in the campaign work tree. It holds,
+## per template, the PMP geometry reference, the L2M material layer and the
+## object declarations of `data/Templates/<name>.tcl`.
+##
+## FACT (source: data/Templates/urw_*.tcl): a template is
+##   `map_template <pmp> $xoffset $yoffset`   -> geometry grid,
+##   `map_setlayer2 $xoffset $yoffset <l2m>`   -> material layer,
+##   plus a list of `[new <Class> ...]` objects with local coordinates, rotation
+##   and the owner/physic/autolight/boxed flags.
+
+const MANIFEST_PATH: String = "res://models/campaign_urwald_first_level.json"
+
+var _templates: Dictionary = {}
+var _missing: Array[String] = []
+var _loaded: bool = false
+
+
+func load_manifest(path: String = MANIFEST_PATH) -> bool:
+	var decoded: Variant = JSON.parse_string(FileAccess.get_file_as_string(path))
+	if not decoded is Dictionary:
+		push_error("Campaign template manifest is missing: " + path)
+		return false
+	var manifest: Dictionary = decoded
+	var entries: Dictionary = manifest.get("templates", {})
+	for key: Variant in entries.keys():
+		_templates[str(key)] = entries[key]
+	var missing: Array = manifest.get("missing_templates", [])
+	for name: Variant in missing:
+		_missing.append(str(name))
+	_loaded = true
+	return true
+
+
+func is_loaded() -> bool:
+	return _loaded
+
+
+func get_template_count() -> int:
+	return _templates.size()
+
+
+func has_template(name: String) -> bool:
+	return _templates.has(name)
+
+
+## Templates that the original table references but the game data does not ship.
+func missing_templates() -> Array[String]:
+	return _missing.duplicate()
+
+
+## Decoded template description: pmp/l2m grids plus the object list.
+func get_template(name: String) -> Dictionary:
+	if not _templates.has(name):
+		return {}
+	var raw: Dictionary = _templates[name]
+	var result: Dictionary = {
+		"name": name,
+		"source": str(raw.get("source", "")),
+		"kind": str(raw.get("kind", "direct")),
+		"objects": raw.get("objects", []),
+	}
+	if raw.has("pmp"):
+		var pmp: Dictionary = raw["pmp"]
+		result["pmp"] = {
+			"file": str(pmp["file"]),
+			"width": int(pmp["width"]),
+			"height": int(pmp["height"]),
+			"sha256": str(pmp["sha256"]),
+			"flags": Marshalls.base64_to_raw(str(pmp["flags_b64"])),
+			"blocks": Marshalls.base64_to_raw(str(pmp["blocks_b64"])).to_int32_array(),
+			"attributes": Marshalls.base64_to_raw(str(pmp["attributes_b64"])),
+		}
+	if raw.has("l2m"):
+		var l2m: Dictionary = raw["l2m"]
+		result["l2m"] = {
+			"file": str(l2m["file"]),
+			"width": int(l2m["width"]),
+			"height": int(l2m["height"]),
+			"sha256": str(l2m["sha256"]),
+			"words": Marshalls.base64_to_raw(str(l2m["words_b64"])).to_int32_array(),
+		}
+	return result

diff --git a/scripts/diggles_irandom.gd b/scripts/diggles_irandom.gd
new file mode 100644
--- /dev/null
+++ b/scripts/diggles_irandom.gd
@@ -0,0 +1,118 @@
+extends RefCounted
+## Diggles.exe `irandom` stream, recovered from the native binary.
+##
+## FACT (Diggles.exe disassembly, read-only source of truth):
+##   * `irandom` is a native Tcl command. Its name is registered at 0x61AFC8 and
+##     the handler lives at 0x62F780.
+##   * The handler draws one 32 bit value from the generator at 0x49C670, masks
+##     it with 0x7FFFFFFF and returns the remainder of the Tcl argument:
+##     `irandom n` == `(draw & 0x7FFFFFFF) % n`. A limit of 1 (or 0) divides by
+##     0x7FFFFFFF instead.
+##   * The generator is a Mersenne Twister: 624 state words, the classic mag01
+##     table {0x0, 0x9908B0DF}, tempering masks 0x9D2C5680 and 0xEFC60000.
+##     The state is *not* filled by the standard MT19937 initialiser; the native
+##     seeding routine at 0x4454D0 derives it from an LCG with the multiplier
+##     69069.
+##   * Diggles.exe seeds the generator once at start-up with `GetTickCount()`
+##     (0x401AE0 -> 0x4454D0), so the original campaign level depends on the
+##     moment the game started. The algorithm is reproduced here; the seed value
+##     is chosen by the host.
+##
+## The draw order therefore matches the original. Only the seed differs from a
+## recorded original session.
+
+const STATE_SIZE: int = 624
+const LAST_INDEX: int = 623
+const MATRIX_A: int = 0x9908B0DF
+const TEMPER_B: int = 0x9D2C5680
+const TEMPER_C: int = 0xEFC60000
+const LCG_MULTIPLIER: int = 69069
+const UINT32: int = 0xFFFFFFFF
+const SIGN_CLEARED: int = 0x7FFFFFFF
+const FIRST_LOOP_END: int = 227
+const MATRIX_LAG: int = 397
+const SECOND_LOOP_LAG: int = 227
+const LAST_ELEMENT_SOURCE: int = 396
+
+var _state: PackedInt32Array = PackedInt32Array()
+var _index: int = 0
+
+
+func _init(seed_value: int = 0) -> void:
+	seed_with(seed_value)
+
+
+## Fill the 624 word state exactly like the native routine at 0x4454D0.
+func seed_with(seed_value: int) -> void:
+	_state.resize(STATE_SIZE)
+	var value: int = seed_value & UINT32
+	for index: int in range(STATE_SIZE):
+		var high: int = value & 0xFFFF0000
+		var next_value: int = ((value * LCG_MULTIPLIER) + 1) & UINT32
+		_state[index] = high | (next_value >> 16)
+		value = ((next_value * LCG_MULTIPLIER) + 1) & UINT32
+	_index = STATE_SIZE
+
+
+## One tempered 32 bit draw, identical to the native generator at 0x49C670.
+func next_u32() -> int:
+	var value: int = 0
+	if _index >= STATE_SIZE:
+		_twist()
+		_index = 1
+		value = _state[0] & UINT32
+	else:
+		value = _state[_index] & UINT32
+		_index += 1
+	return _temper(value)
+
+
+## The native `irandom n` command.
+##
+## The handler reads the argument with `Tcl_GetIntFromObj` into a local int,
+## divides the masked draw by that value and keeps the remainder. A limit of
+## zero is replaced by 0x7FFFFFFF; a limit of one therefore yields zero, which
+## is what Campaign.tcl relies on for its single element shift lists.
+func irandom(limit: int) -> int:
+	var value: int = next_u32() & SIGN_CLEARED
+	if limit == 0:
+		return value % SIGN_CLEARED
+	return value % limit
+
+
+func _temper(value: int) -> int:
+	var result: int = value & UINT32
+	result = (result ^ (result >> 11)) & UINT32
+	result = (result ^ ((result << 7) & TEMPER_B)) & UINT32
+	result = (result ^ ((result << 15) & TEMPER_C)) & UINT32
+	result = (result ^ (result >> 18)) & UINT32
+	return result
+
+
+## The native state is unsigned. GDScript integers are signed, so every word is
+## masked back into the 0..0xFFFFFFFF range before it is shifted.
+func _twist() -> void:
+	for index: int in range(0, FIRST_LOOP_END):
+		var current: int = _state[index] & UINT32
+		var following: int = _state[index + 1] & UINT32
+		var mixed: int = (((current ^ following) & SIGN_CLEARED) ^ current) & UINT32
+		mixed = ((mixed >> 1) ^ (MATRIX_A if (mixed & 1) != 0 else 0)) & UINT32
+		_state[index] = (mixed ^ (_state[index + MATRIX_LAG] & UINT32)) & UINT32
+	for index: int in range(FIRST_LOOP_END, LAST_INDEX):
+		var current: int = _state[index] & UINT32
+		var following: int = _state[index + 1] & UINT32
+		var mixed: int = (((current ^ following) & SIGN_CLEARED) ^ current) & UINT32
+		mixed = ((mixed >> 1) ^ (MATRIX_A if (mixed & 1) != 0 else 0)) & UINT32
+		_state[index] = (mixed ^ (_state[index - SECOND_LOOP_LAG] & UINT32)) & UINT32
+	# Native index 623: the engine's bounds guard falls back to state[0].
+	var tail_current: int = _state[LAST_INDEX] & UINT32
+	var tail_next: int = _state[0] & UINT32
+	var tail: int = (((tail_current ^ tail_next) & SIGN_CLEARED) ^ tail_current) & UINT32
+	tail = ((tail >> 1) ^ (MATRIX_A if (tail & 1) != 0 else 0)) & UINT32
+	_state[LAST_INDEX] = (tail ^ (_state[LAST_ELEMENT_SOURCE] & UINT32)) & UINT32
+	# Native post-twist step at 0x49C87A: one further state[623] update.
+	var previous: int = _state[LAST_INDEX] & UINT32
+	var first: int = _state[0] & UINT32
+	var post: int = (((first ^ previous) & SIGN_CLEARED) ^ previous) & UINT32
+	post = ((post >> 1) ^ (MATRIX_A if (post & 1) != 0 else 0)) & UINT32
+	_state[LAST_INDEX] = (post ^ (_state[LAST_ELEMENT_SOURCE] & UINT32)) & UINT32

diff --git a/tools/campaign_level_generator_self_test.gd b/tools/campaign_level_generator_self_test.gd
new file mode 100644
--- /dev/null
+++ b/tools/campaign_level_generator_self_test.gd
@@ -0,0 +1,274 @@
+extends SceneTree
+## Self-test of the Urwald campaign level generator.
+##
+## It checks the recovered `irandom` stream, the `Campaign.tcl:first_level`
+## placement list against golden values, the determinism of the generator, the
+## overlay of the geometry and the material layer, the player dwarves on the
+## start template, the `Wuker` removal and the fog rectangle of the original
+## campaign script.
+
+const GENERATOR := preload("res://scripts/diggles_campaign_generator.gd")
+const TEMPLATES := preload("res://scripts/diggles_campaign_templates.gd")
+const COMPOSER := preload("res://scripts/diggles_campaign_composer.gd")
+const SCENE := preload("res://scripts/diggles_campaign_scene.gd")
+const RNG := preload("res://scripts/diggles_irandom.gd")
+
+const GOLDEN_PATH: String = "res://models/campaign_urwald_first_level_golden.json"
+const MANIFEST_PATH: String = "res://models/campaign_urwald_first_level.json"
+const GOLDEN_SEEDS: Array[int] = [1, 4357, 123456789]
+
+var _checks: int = 0
+var _failures: int = 0
+
+
+func _initialize() -> void:
+	call_deferred("_run")
+
+
+func _check(condition: bool, message: String) -> bool:
+	_checks += 1
+	if not condition:
+		_failures += 1
+		push_error("CAMPAIGN_LEVEL_GENERATOR_SELF_TEST_FAILED " + message)
+	return condition
+
+
+func _run() -> void:
+	var golden: Dictionary = _load_json(GOLDEN_PATH)
+	var templates: TEMPLATES = TEMPLATES.new()
+	if not templates.load_manifest(MANIFEST_PATH):
+		_failures += 1
+		push_error("CAMPAIGN_LEVEL_GENERATOR_SELF_TEST_FAILED manifest")
+		quit(1)
+		return
+	_check(templates.is_loaded(), "manifest load")
+
+	_check_rng()
+	_check_generator(golden)
+	_check_composition(templates, golden)
+	await _check_scene(templates, golden)
+
+	if _failures > 0:
+		print("CAMPAIGN_LEVEL_GENERATOR_SELF_TEST_FAILED checks=%d failures=%d" % [_checks, _failures])
+		quit(1)
+		return
+	print("CAMPAIGN_LEVEL_GENERATOR_SELF_TEST_OK assertions=%d templates=%d seeds=%d" % [
+		_checks, templates.get_template_count(), GOLDEN_SEEDS.size()])
+	quit(0)
+
+
+func _load_json(path: String) -> Dictionary:
+	var decoded: Variant = JSON.parse_string(FileAccess.get_file_as_string(path))
+	if not decoded is Dictionary:
+		return {}
+	return decoded
+
+
+func _check_rng() -> void:
+	# Golden draws of the native irandom stream, produced by the independent
+	# Python reference implementation of Diggles.exe 0x49C670.
+	var golden: Dictionary = _load_json(GOLDEN_PATH)
+	for key: Variant in golden.keys():
+		var seed_value: int = int(key)
+		var entry: Dictionary = golden[key]
+		var draws: Array = entry["draws"]
+		var rng: RNG = RNG.new(seed_value)
+		for index: int in range(draws.size()):
+			_check(rng.next_u32() == int(draws[index]),
+					"irandom draw %d of seed %d" % [index, seed_value])
+	# The native command divides by its argument, so a limit of one is zero.
+	var limiter: RNG = RNG.new(1)
+	_check(limiter.irandom(1) == 0, "irandom(1) must be zero")
+	for limit: int in [2, 3, 5, 8, 6, 4, 7]:
+		var bounded: RNG = RNG.new(limit)
+		for _step: int in range(32):
+			var value: int = bounded.irandom(limit)
+			_check(value >= 0 and value < limit, "irandom(%d) range" % limit)
+
+
+func _check_generator(golden: Dictionary) -> void:
+	for key: Variant in golden.keys():
+		var seed_value: int = int(key)
+		var entry: Dictionary = golden[key]
+		var generator: GENERATOR = GENERATOR.new()
+		var level: Dictionary = generator.first_level(208, 0, seed_value)
+		var placements: Array = level["placements"]
+		var expected: Array = entry["placements"]
+		_check(placements.size() == expected.size(), "placement count of seed %d" % seed_value)
+		var count: int = mini(placements.size(), expected.size())
+		for index: int in range(count):
+			var actual: Dictionary = placements[index]
+			var reference: Dictionary = expected[index]
+			_check(str(actual["template"]) == str(reference["template"]),
+					"template %d of seed %d" % [index, seed_value])
+			_check(int(actual["x"]) == int(reference["x"]),
+					"template %d x of seed %d" % [index, seed_value])
+			_check(int(actual["y"]) == int(reference["y"]),
+					"template %d y of seed %d" % [index, seed_value])
+		# Determinism: the same seed always yields the same level.
+		var repeat: Dictionary = generator.first_level(208, 0, seed_value)
+		_check(repeat["placements"] == placements, "determinism of seed %d" % seed_value)
+	# A different seed must not repeat the same level.
+	var first: Dictionary = GENERATOR.new().first_level(208, 0, 1)
+	var other: Dictionary = GENERATOR.new().first_level(208, 0, 2)
+	_check(first["placements"] != other["placements"], "distinct seeds differ")
+
+
+func _check_composition(templates: TEMPLATES, golden: Dictionary) -> void:
+	var generator: GENERATOR = GENERATOR.new()
+	var composer: COMPOSER = COMPOSER.new()
+	var level: Dictionary = generator.first_level(208, 0, 1)
+	var composed: Dictionary = composer.compose(level["placements"], templates)
+	_check(composed["size"] == Vector2i(512, 640), "map size")
+	var cells: Array = composed["cells"]
+	_check(cells.size() > 0, "composed cells")
+	var layer2: PackedInt32Array = composed["layer2_words"]
+	_check(layer2.size() == 512 * 640, "material layer size")
+
+	# The start template is stamped at (208, 0); its geometry and its material
+	# layer must land on the same cells.
+	var start: Dictionary = templates.get_template("urw_unq_start")
+	var start_pmp: Dictionary = start["pmp"]
+	var start_l2m: Dictionary = start["l2m"]
+	var start_words: PackedInt32Array = start_l2m["words"]
+	_check(start_pmp["width"] == 60 and start_pmp["height"] == 36, "start template geometry size")
+	var material_ok: bool = true
+	for row: int in range(start_l2m["height"]):
+		for column: int in range(start_l2m["width"]):
+			var world_x: int = 208 + column
+			var world_y: int = 0 + row
+			if layer2[world_y * 512 + world_x] != start_words[row * int(start_l2m["width"]) + column]:
+				material_ok = false
+	_check(material_ok, "start template material overlay")
+
+	# The cave painting contributes its material layer at (30, 23) only.
+	var painting: Dictionary = templates.get_template("urw_unq_hoehlenmalerei")
+	var painting_words: PackedInt32Array = painting["l2m"]["words"]
+	var painting_ok: bool = true
+	for row: int in range(int(painting["l2m"]["height"])):
+		for column: int in range(int(painting["l2m"]["width"])):
+			if layer2[(23 + row) * 512 + (30 + column)] != painting_words[row * int(painting["l2m"]["width"]) + column]:
+				painting_ok = false
+	_check(painting_ok, "cave painting material overlay")
+
+	# A placed cave must carry its own geometry and material.
+	var cave_placement: Dictionary = level["placements"][0]
+	var cave: Dictionary = templates.get_template(str(cave_placement["template"]))
+	var cave_words: PackedInt32Array = cave["l2m"]["words"]
+	var cave_ok: bool = true
+	for row: int in range(int(cave["l2m"]["height"])):
+		for column: int in range(int(cave["l2m"]["width"])):
+			var world_x: int = int(cave_placement["x"]) + column
+			var world_y: int = int(cave_placement["y"]) + row
+			if layer2[world_y * 512 + world_x] != cave_words[row * int(cave["l2m"]["width"]) + column]:
+				cave_ok = false
+	_check(cave_ok, "cave material overlay")
+
+	# The player dwarves come from the start template.
+	var objects: Array = composed["objects"]
+	var dwarves: int = 0
+	var resources: int = 0
+	var wukers: int = 0
+	for object: Dictionary in objects:
+		var object_class: String = str(object["class"])
+		if object_class == "Zwerg":
+			dwarves += 1
+			_check(object["owner"] == 0, "dwarf owner flag")
+			_check(object["autolight"] == true, "dwarf autolight flag")
+		elif object_class == "Pilz" or object_class == "Raupe" or object_class == "Stein":
+			resources += 1
+		elif object_class == "Wuker":
+			wukers += 1
+	_check(dwarves == 5, "player dwarves on the start template")
+	_check(resources > 0, "cave resources")
+	_check(wukers == 0, "Wuker objects removed")
+
+	# The removal has to be meaningful: the raw templates do contain Wukers.
+	var raw_wukers: int = 0
+	for name: String in ["urw_hol_001_a", "urw_hol_027_a", "urw_gng_002_b"]:
+		var template: Dictionary = templates.get_template(name)
+		for object: Dictionary in template["objects"]:
+			if str(object["class"]) == "Wuker":
+				raw_wukers += 1
+	_check(raw_wukers > 0, "templates contain Wuker objects")
+
+	# A resource of the first cave must sit at the template relative position.
+	var resource_ok: bool = false
+	for object: Dictionary in objects:
+		if str(object["class"]) == "Pilz" and str(object["template"]) == str(cave_placement["template"]):
+			resource_ok = true
+	_check(resource_ok, "cave resource placement")
+
+	# Every surviving object of the first placed cave keeps its template
+	# relative position, and the cave resources keep their class and flags.
+	var cave_name: String = str(cave_placement["template"])
+	var cave_source: Dictionary = templates.get_template(cave_name)
+	var expected_objects: int = 0
+	var placed_objects: int = 0
+	for source: Dictionary in cave_source["objects"]:
+		if str(source["class"]) == "Wuker":
+			continue
+		expected_objects += 1
+		for object: Dictionary in objects:
+			if str(object["template"]) != cave_name:
+				continue
+			if str(object["class"]) != str(source["class"]):
+				continue
+			if absf(float(object["x"]) - (float(cave_placement["x"]) + float(source["x"]))) > 0.0001:
+				continue
+			if absf(float(object["y"]) - (float(cave_placement["y"]) + float(source["y"]))) > 0.0001:
+				continue
+			if absf(float(object["z"]) - float(source["z"])) > 0.0001:
+				continue
+			_check(object["physic"] == source["flags"].get("physic", null),
+					"cave object physic flag of " + cave_name)
+			placed_objects += 1
+			break
+	_check(placed_objects == expected_objects,
+			"every cave object keeps its template position (%d of %d)" % [placed_objects, expected_objects])
+
+	# The resources of the cave template must exist with the native classes.
+	var cave_resources: int = 0
+	for source: Dictionary in cave_source["objects"]:
+		if str(source["class"]) == "Pilz" or str(source["class"]) == "Raupe" or str(source["class"]) == "Stein":
+			cave_resources += 1
+	_check(cave_resources > 0, "cave template declares resources")
+
+	# The fog remover of Campaign.tcl:205-209.
+	var fog: Dictionary = composed["fog"]
+	_check(fog["position"] == Vector3i(239, 14, 15), "fog remover position")
+	_check(fog["rect"] == Vector3i(0, 46, 22), "fog remover rectangle")
+	_check(fog["undeletable"] == true, "fog remover is undeletable")
+
+
+func _check_scene(templates: TEMPLATES, golden: Dictionary) -> void:
+	var generator: GENERATOR = GENERATOR.new()
+	var composer: COMPOSER = COMPOSER.new()
+	var level: Dictionary = generator.first_level(208, 0, 1)
+	var composed: Dictionary = composer.compose(level["placements"], templates)
+	var scene: Node3D = SCENE.build(composed)
+	root.add_child(scene)
+	await process_frame
+	var terrain: MeshInstance3D = scene.get_node("CampaignTerrain") as MeshInstance3D
+	_check(terrain != null, "campaign terrain node")
+	if terrain != null:
+		_check(terrain.mesh != null, "campaign terrain mesh")
+		_check(terrain.mesh.get_surface_count() == 1, "campaign terrain surface")
+	var objects: Node3D = scene.get_node("CampaignObjects") as Node3D
+	_check(objects != null, "campaign objects node")
+	if objects != null:
+		_check(objects.get_child_count() == composed["objects"].size(), "campaign object count")
+		var dwarf_nodes: int = 0
+		var wuker_nodes: int = 0
+		for child: Node in objects.get_children():
+			if str(child.get_meta("native_class", "")) == "Zwerg":
+				dwarf_nodes += 1
+			if str(child.get_meta("native_class", "")) == "Wuker":
+				wuker_nodes += 1
+		_check(dwarf_nodes == 5, "campaign dwarf nodes")
+		_check(wuker_nodes == 0, "campaign Wuker nodes")
+	var fog: Node3D = scene.get_node("FogRemover") as Node3D
+	_check(fog != null, "campaign fog node")
+	if fog != null:
+		_check(fog.get_meta("native_fog_remove", Vector3i.ZERO) == Vector3i(0, 46, 22), "campaign fog rectangle")
+	scene.queue_free()
