  "walk_pos_dig_lines": [
    {
      "line": 705,
      "text": "proc walk_pos_dig {pos dpos} {"
    },
    {
      "line": 706,
      "text": "\tstate_disable this"
    },
    {
      "line": 707,
      "text": "//\tlog \"[get_objname this]: state_disable fьr walkpos...\""
    },
    {
      "line": 708,
      "text": "//\tlog \"DIG_VERSUCHE = $dig_versuche\""
    },
    {
      "line": 709,
      "text": "\tset pos [vector_fix $pos]"
    },
    {
      "line": 710,
      "text": "\tif {[get_gnomeposition this]&&[get_hmap [lindex $pos 0] [lindex $pos 1]]<12} {"
    },
    {
      "line": 711,
      "text": "\t\tset speed \"-speedtype 2\""
    },
    {
      "line": 712,
      "text": "\t} else {"
    },
    {
      "line": 713,
      "text": "\t\tset speed \"\""
    },
    {
      "line": 714,
      "text": "\t}"
    },
    {
      "line": 715,
      "text": "\twalk_action \"-target \\{$pos\\} -waving 0 -dig 1 -digpos \\{$dpos\\} $speed\" {"
    },
    {
      "line": 716,
      "text": "\t\twalkfail"
    },
    {
      "line": 717,
      "text": "\t\treturn true"
    },
    {
      "line": 718,
      "text": "\t} {"
    },
    {
      "line": 719,
      "text": "\t\t//log \"[get_objname this]: walk break\""
    },
    {
      "line": 720,
      "text": "\t}"
    },
    {
      "line": 721,
      "text": "\treturn true"
    },
    {
      "line": 722,
      "text": "}"
    }
