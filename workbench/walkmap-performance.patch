+		if upper2_row < 0:
+			return null
+		var upper2: int = heights[upper2_row * stride + column]
+		if upper2 < 0:
+			return null
+		if upper2 + 2 < below:
+			return 3
+	if upper_unknown:
+		return null
+	return 1
